<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12.0dp" />
            <solid android:color="#14898989" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12.0dp" />
            <gradient android:startColor="#29f0c461" android:endColor="#00f0c461" android:angle="0.0" android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12.0dp" />
            <stroke android:width="1.0dp" android:color="#c2862e" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
