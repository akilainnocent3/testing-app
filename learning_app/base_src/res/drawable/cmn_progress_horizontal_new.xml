<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:drawable="@drawable/transparent" />
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="2.0dp" />
                <gradient android:startColor="#8000d300" android:endColor="#a000cb00" android:angle="270.0" android:centerY="0.75" android:centerColor="#8000b600" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="2.0dp" />
                <solid android:color="#ffff9900" />
            </shape>
        </clip>
    </item>
</layer-list>
